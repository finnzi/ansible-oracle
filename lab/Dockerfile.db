# syntax=docker/dockerfile:1
#
# lab/Dockerfile.db — Oracle Linux 9 base for Oracle Database + Oracle Restart
# (Grid Infrastructure standalone) nodes in the lab.
#
# Why systemd? Oracle Restart's ohasd/cssd expect an init system as PID 1.
# The vertical slice deliberately runs Restart *faithfully* (per the agreed
# design): a privileged container with /usr/sbin/init as PID 1, cgroup mounts,
# and the oracle-database-preinstall-19c package. This is a lab-only image —
# see lab/README.md for the security implications.
#
# Base image: full oraclelinux:9 (NOT slim — slim ships no systemd).

FROM oraclelinux:9

# Build args let us rebuild without editing the file.
ARG ORACLE_PREINSTALL_RPM=oracle-database-preinstall-19c

# ── 1. Systemd-in-container essentials ─────────────────────────────────
# Install systemd and a passthrough init. We also need sshd for Ansible (the
# playbooks connect over SSH, not docker exec) and a working sudo.
RUN dnf -y update && \
    dnf -y install \
        systemd \
        systemd-sysv \
        openssh-server \
        openssh-clients \
        sudo \
        python3 \
        which \
        tar \
        gzip \
        unzip \
        net-tools \
        bind-utils \
        procps-ng \
        iproute \
        initscripts \
    && dnf clean all

# Neutralise units that don't belong in a container so systemd boots cleanly.
RUN systemctl mask \
        dev-mqueue.mount \
        dev-hugepages.mount \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket \
        systemd-journald-audit.socket \
        systemd-resolved.service \
        systemd-networkd.service \
        firewalld.service \
    || true

# ── 2. SSH for Ansible ─────────────────────────────────────────────────
RUN ssh-keygen -A && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    mkdir -p /root/.ssh && chmod 700 /root/.ssh

# Pre-seed an authorized_keys for the lab root. The public key is written at
# build time from a build arg; default is empty (lab-up.sh injects it).
ARG LAB_PUBKEY=""
RUN if [ -n "$LAB_PUBKEY" ]; then \
        echo "$LAB_PUBKEY" > /root/.ssh/authorized_keys; \
    fi
RUN chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true

# Passwordless sudo for the oracle user (created by the preinstall RPM, but
# we add a fallback sudoers entry for the playbooks that run as oracle).
RUN echo "oracle ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/oracle && chmod 0440 /etc/sudoers.d/oracle

# ── 3. Oracle preinstall ───────────────────────────────────────────────
# Sets kernel params, limits, hugepages, creates the oracle user/groups.
# This is the official Oracle Linux RPM; it pulls the right deps for 19c.
RUN dnf -y install ${ORACLE_PREINSTALL_RPM} || \
    echo "WARN: oracle-database-preinstall-19c not available from default repos; " \
         "the oracle_common role will apply equivalent settings." && \
    dnf clean all

# ── 4. Stage mount points for the per-instance directory tree ──────────
# /super/{app,d01,a01,f01,r01} and /grid are bind-mounted at runtime in
# docker-compose so data survives container rebuilds. Create the parents.
RUN mkdir -p /super/app/oracle /super/d01 /super/a01 /super/f01 /super/r01 /grid /u01/stage && \
    chown -R oracle:oinstall /super /grid /u01

# ── 5. Default command: systemd as PID 1 ───────────────────────────────
# CMD [ "/usr/sbin/init" ]  — composed via compose `command:` to keep this
# image reusable. lab/docker-compose.yml sets it explicitly.
CMD ["/usr/sbin/init"]
