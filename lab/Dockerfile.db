# syntax=docker/dockerfile:1
#
# lab/Dockerfile.db — Oracle Linux base for Oracle Database + Oracle Restart
# (Grid Infrastructure standalone) nodes in the lab.
#
# Why systemd? Oracle Restart's ohasd/cssd expect an init system as PID 1.
# The vertical slice deliberately runs Restart *faithfully* (per the agreed
# design): a privileged container with /usr/sbin/init as PID 1, cgroup mounts,
# and the oracle-database-preinstall-19c package. This is a lab-only image —
# see lab/README.md for the security implications.
#
# Base image: oraclelinux:7-slim, with systemd + python3.9 (for Ansible).
#
# OL version note (important): the 19.3 base installer (2019) is certified on
# OL7 but NOT on newer OL8.x/OL9/OL10 minor releases — it NPEs in
# supportedOSCheck and its linker fails against modern glibc/binutils, and the
# -applyRU path does not complete in this offline lab. So the lab base is OL7,
# where 19.3 installs cleanly with NO workarounds (no CV_ASSUME_DISTID, no
# applyRU). The 19.31 RU is applied AFTER install via oracle_patch (standby-
# first detection is real; apply is the next engagement's work). OL8/OL9/OL10
# support is documented in lab/README.md.

FROM oraclelinux:7-slim

ARG ORACLE_PREINSTALL_RPM=oracle-database-preinstall-19c

# ── 1. Systemd + base tooling ─────────────────────────────────────────
# OL7 slim ships yum (not dnf). Enable ol7_addons for the preinstall RPM.
RUN yum install -y oracle-epel-release-el7 && \
    yum-config-manager --enable ol7_addons ol7_optional_latest 2>/dev/null || true && \
    yum -y install \
        systemd \
        systemd-sysv \
        openssh-server \
        openssh-clients \
        sudo \
        initscripts \
        which \
        tar \
        gzip \
        unzip \
        net-tools \
        bind-utils \
        procps-ng \
        openssl-devel \
        libffi-devel \
        bzip2-devel \
        zlib-devel \
        wget \
        make \
        gcc \
        kernel-headers \
        kernel-devel \
    && yum clean all

# Neutralise units that don't belong in a container so systemd boots cleanly.
RUN systemctl mask \
        dev-mqueue.mount \
        dev-hugepages.mount \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket \
        systemd-journald-audit.socket \
        systemd-resolved.service \
        systemd-networkd.service \
        firewalld.service \
        dbus-org.freedesktop.NetworkManager.service \
    || true

# Make systemd actually boot to multi-user (where sshd lives) and ensure the
# D-Bus / machine-id substrate exists so systemctl works inside the container.
RUN systemctl set-default multi-user.target && \
    systemctl enable sshd.service && \
    systemd-machine-id-setup 2>/dev/null || true && \
    mkdir -p /run/systemd/system /var/log/journal

# ── 2. Python 3.9 from source (for Ansible) ───────────────────────────
# OL7's python3 is 3.6, too old for ansible-core's modules. We build CPython
# 3.9 from source (a one-time ~3min compile) so Ansible's interpreter
# discovery finds /usr/local/bin/python3 = 3.9.
ARG PY_VER=3.9.21
RUN cd /tmp && \
    wget -q https://www.python.org/ftp/python/${PY_VER}/Python-${PY_VER}.tgz && \
    tar xzf Python-${PY_VER}.tgz && \
    cd Python-${PY_VER} && \
    ./configure --enable-optimizations=no --prefix=/usr/local >/tmp/py_configure.log 2>&1 && \
    make -j"$(nproc)" -s >/tmp/py_make.log 2>&1 && \
    make altinstall -s >/tmp/py_install.log 2>&1 && \
    ln -sf /usr/local/bin/python3.9 /usr/local/bin/python3 && \
    ln -sf /usr/local/bin/python3.9 /usr/bin/python3.9 && \
    cd / && rm -rf /tmp/Python-${PY_VER}* && \
    /usr/local/bin/python3.9 -m ensurepip && \
    /usr/local/bin/python3.9 -m pip install --upgrade pip && \
    python3 --version

# ── 3. SSH for Ansible ─────────────────────────────────────────────────
RUN ssh-keygen -A && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
ARG LAB_PUBKEY=""
RUN if [ -n "$LAB_PUBKEY" ]; then echo "$LAB_PUBKEY" > /root/.ssh/authorized_keys; fi
RUN chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true

RUN echo "oracle ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/oracle && chmod 0440 /etc/sudoers.d/oracle

# ── 4. Oracle preinstall ───────────────────────────────────────────────
# Sets kernel params, limits, hugepages, creates the oracle user/groups.
RUN yum -y install ${ORACLE_PREINSTALL_RPM} || \
    echo "WARN: oracle-database-preinstall-19c not installable; oracle_common applies equivalent settings."
RUN yum clean all

# ── 5. Stage mount points for the per-instance directory tree ──────────
RUN mkdir -p /super/app/oracle /super/d01 /super/a01 /super/f01 /super/r01 /grid /u01/stage && \
    chown -R oracle:oinstall /super /grid /u01

CMD ["/usr/sbin/init"]
