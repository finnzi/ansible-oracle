# syntax=docker/dockerfile:1
#
# lab/Dockerfile.observer — lightweight node for the Data Guard broker
# observer (Fast-Start Failover). Reserved for the FSFO slice; built now so
# lab-up.sh brings the third node up and the inventory contract is stable.
#
# The observer needs only: an Oracle Client (Administrator) install + a
# systemd unit running `dgmgrl ... START OBSERVER IN BACKGROUND`. It does NOT
# need Grid Infrastructure or a running database. So we use the slim base and
# systemd (lighter than the DB node but still init-managed for the unit).

FROM oraclelinux:9-slim

RUN dnf -y update && \
    dnf -y install \
        systemd \
        systemd-sysv \
        openssh-server \
        openssh-clients \
        sudo \
        python3 \
        tar \
        gzip \
        unzip \
        bind-utils \
        procps-ng \
    && dnf clean all

# Same systemd-in-container hygiene as the DB image.
RUN systemctl mask \
        dev-mqueue.mount \
        dev-hugepages.mount \
        systemd-udevd.service \
        systemd-udevd-control.socket \
        systemd-udevd-kernel.socket \
        systemd-journald-audit.socket \
        systemd-resolved.service \
        systemd-networkd.service \
        firewalld.service \
    || true

# SSH for Ansible.
RUN ssh-keygen -A && \
    sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config && \
    mkdir -p /root/.ssh && chmod 700 /root/.ssh
ARG LAB_PUBKEY=""
RUN if [ -n "$LAB_PUBKEY" ]; then echo "$LAB_PUBKEY" > /root/.ssh/authorized_keys; fi
RUN chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true

# Observer software tree (client install target).
RUN mkdir -p /observer/app/oracle/client_home1 /u01/stage && \
    groupadd -g 54321 oinstall 2>/dev/null || true && \
    useradd -u 54321 -g oinstall -G dba oracle 2>/dev/null || true && \
    chown -R oracle:oinstall /observer /u01 && \
    echo "oracle ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/oracle && \
    chmod 0440 /etc/sudoers.d/oracle

CMD ["/usr/sbin/init"]
