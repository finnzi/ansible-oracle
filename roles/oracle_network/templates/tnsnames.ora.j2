{# tnsnames.ora.j2 — client-facing connect descriptors. #}
{# Managed by ansible-oracle / oracle_network. #}
# Direct EZCONNECT-style alias for the client service that always points at
# the current primary (oracle_service_manage creates the service).
{{ inst.service_name | default(inst.name ~ '_svc') }} =
  (DESCRIPTION =
{% if inst.dataguard | default(false) | bool %}
    (ADDRESS_LIST =
      (FAILOVER = ON)
      (LOAD_BALANCE = OFF)
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ inst.name }}dc1.{{ lab_domain | default('domain.is') }})(PORT = {{ inst._port }}))
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ inst.name }}dc2.{{ lab_domain | default('domain.is') }})(PORT = {{ inst._port }}))
    )
{% else %}
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ inst._net }})(PORT = {{ inst._port }}))
{% endif %}
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ inst.service_name | default(inst.name ~ '_svc') }})
    )
  )

# The instance itself (useful for administration / sqlplus / as sysdba).
{{ inst.name }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ inst._net }})(PORT = {{ inst._port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SID = {{ inst.name }})
    )
  )

{% if inst.dataguard | default(false) | bool %}
# Data Guard broker connect identifiers. Each database host needs both site
# aliases so DGMGRL can create, inspect, and switchover the configuration.
{% set dg_domain = lab_domain | default('domain.is') %}
{% set dg_primary_unique = inst.dg_primary_db_unique_name | default(inst.name) %}
{% set dg_standby_unique = inst.dg_standby_db_unique_name | default(inst.name ~ '_sby') %}
{% set dg_sites = [
  {'alias': dg_primary_unique ~ '_dgb', 'host': inst.name ~ 'dc1.' ~ dg_domain, 'service_name': dg_primary_unique ~ '_DGMGRL'},
  {'alias': dg_standby_unique ~ '_dgb', 'host': inst.name ~ 'dc2.' ~ dg_domain, 'service_name': dg_standby_unique ~ '_DGMGRL'},
] %}
{% for dg in dg_sites %}
{{ dg.alias }} =
  (DESCRIPTION =
    (ADDRESS = (PROTOCOL = TCP)(HOST = {{ dg.host }})(PORT = {{ inst._port }}))
    (CONNECT_DATA =
      (SERVER = DEDICATED)
      (SERVICE_NAME = {{ dg.service_name }})
    )
  )

{% endfor %}
{% endif %}
