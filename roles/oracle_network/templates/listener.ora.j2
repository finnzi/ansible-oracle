{# listener.ora.j2 — per-instance listener bound to the dedicated VIP. #}
{# Managed by ansible-oracle / oracle_network. Do not edit by hand. #}
# Listener for instance {{ inst.name }} on dedicated {{ inst._vip }}:{{ inst._port }}
LISTENER_{{ inst.name | upper }} =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = {{ inst._vip }})(PORT = {{ inst._port }}))
    )
  )

# Static SID_LIST so the listener answers even before PMON registers.
SID_LIST_LISTENER_{{ inst.name | upper }} =
  (SID_LIST =
    (SID_DESC =
      (GLOBAL_DBNAME = {{ inst.name }})
      (ORACLE_HOME = {{ inst.oracle_base }}/{{ inst._home }})
      (SID_NAME = {{ inst.name }})
    )
{% if inst.dataguard | default(false) | bool %}
    (SID_DESC =
      (GLOBAL_DBNAME = {{ inst.db_unique_name | default(inst.name) }}_DGMGRL)
      (ORACLE_HOME = {{ inst.oracle_base }}/{{ inst._home }})
      (SID_NAME = {{ inst.name }})
    )
{% endif %}
  )

# Administrative connection helper
ADR_BASE_LISTENER_{{ inst.name | upper }} = {{ inst.oracle_base }}
