{# db_install.rsp.j2 — silent response file for the 19c Database installer. #}
{# Managed by ansible-oracle / oracle_db_install. #}
# Software-only install; DBCA is run separately by oracle_db_manage.
oracle.install.responseFileVersion=/oracle/install/rspfmt_dbinstall_response_schema_v19.0.0
oracle.install.option=INSTALL_DB_SWONLY
ORACLE_HOSTNAME={{ ansible_hostname }}
UNIX_GROUP_NAME={{ oracle_group }}
INVENTORY_LOCATION={{ oracle_inventory_loc }}
SELECTED_LANGUAGES=en,en_US
ORACLE_HOME={{ tgt.home_path }}
ORACLE_BASE={{ tgt.oracle_base }}
oracle.install.db.InstallEdition={{ oracle_install_edition }}
oracle.install.db.OSDBA_GROUP={{ oracle_primary_group_role | default('dba') }}
oracle.install.db.OSOPER_GROUP=oper
oracle.install.db.OSBACKUPDBA_GROUP=backupdba
oracle.install.db.OSDGDBA_GROUP=dgdba
oracle.install.db.OSKMDBA_GROUP=kmdba
oracle.install.db.OSRACDBA_GROUP=dba
oracle.install.db.root.config.executeRootScript=false
oracle.install.db.config.starterdb.type=GENERAL_PURPOSE
oracle.install.db.ConfigureLaterOption=true
SECURITY_UPDATES_VIA_MYORACLESUPPORT=false
DECLINE_SECURITY_UPDATES=true
