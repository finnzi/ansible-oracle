#!/usr/bin/env bash
set -euo pipefail

: "${DGMGRL_CONNECT:?}"
: "${OBSERVER_CLIENT_HOME:?}"
: "${TNS_ADMIN:?}"
: "${OBSERVER_NAME:?}"
: "${OBSERVER_FILE:?}"
: "${OBSERVER_LOGFILE:?}"

export ORACLE_HOME="$OBSERVER_CLIENT_HOME"
export TNS_ADMIN

exec "$ORACLE_HOME/bin/dgmgrl" -silent "$DGMGRL_CONNECT" <<DGMGRL
START OBSERVER ${OBSERVER_NAME} FILE IS ${OBSERVER_FILE} LOGFILE IS ${OBSERVER_LOGFILE};
DGMGRL
